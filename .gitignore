# =========================================================================
# PESIGN MASTER PRODUCTION GITIGNORE
# Target Environment: Next.js, TypeScript, Tailwind, Vercel, Node.js
# =========================================================================

# 1. CORE DEPENDENCIES
node_modules/
/node_modules
*/node_modules/*
.pnpm-store/

# 2. ENVIRONMENT VARIABLES & SECRETS
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*

# 3. NEXT.JS BUILD OUTPUTS & LOCAL CACHES
.next/
/out/
dist/
build/
.next-env.d.ts

# 4. VERCEL DEPLOYMENT CONFIGURATIONS
.vercel
.vercel/

# 5. DIAGNOSTICS & LOGS
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. DATABASE & RUNTIMES
*.db
*.sqlite
*.sql
*.dump
.prisma/client/

# 7. IDE, EDITORS & OS ARTIFACTS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# 8. TESTING & COMPILER CACHES
coverage/
*.tsbuildinfo
